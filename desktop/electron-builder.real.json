{
  "appId": "com.dasturxon.pos",
  "productName": "DasturXon",
  "electronVersion": "31.3.1",
  "directories": {
    "output": "release"
  },
  "files": ["out/**/*", "package.json"],
  "extraResources": [
    { "from": ".server-bundle", "to": "server" },
    { "from": ".runtime", "to": "runtime" }
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "runAfterFinish": true,
    "artifactName": "DasturXon-Server-${version}.${ext}"
  }
}
